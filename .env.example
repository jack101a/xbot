# ==============================================================================
# Host Deployment & Permissions
# ==============================================================================
PUID=1000
PGID=1000
TZ=Asia/Kolkata
CONFIG_PATH=/srv/ajaxhs/config

# Core Database Configuration
# For Docker: sqlite+aiosqlite:////app/data/xbot.db
# For Bare Metal: sqlite+aiosqlite:////home/ubuntu/projects/xbot/data/xbot.db
DATABASE_URL=sqlite+aiosqlite:////app/data/xbot.db

# Redis Message Broker
# For Docker: redis://redis:6379/0
# For Bare Metal: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Profile Storage Directory
# For Docker: /app/data/profiles
# For Bare Metal: ./data/profiles
BASE_PROFILE_DIR=/app/data/profiles

# LiteLLM Gateway Configuration
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=your_litellm_api_key
LITELLM_PRIMARY_MODEL=gemini-flash-latest
LITELLM_FAST_MODEL=deepseek-v4-flash-0731

# Model Tier Cascades (Comma-separated fallback priority)
MODEL_POST_CREATION=chatgpt/auto,litellm/gemini-flash-latest,litellm/deepseek-v4-flash-0731
MODEL_REPLY_ANALYSIS=litellm/gemini-flash-latest,litellm/deepseek-v4-flash-0731
MODEL_HOOK_OPTIMIZER=chatgpt/auto,litellm/gemini-flash-latest,litellm/deepseek-v4-flash-0731
MODEL_POLL_GENERATOR=litellm/gemini-flash-latest,litellm/deepseek-v4-flash-0731
MODEL_PLANNER=litellm/deepseek-v4-flash-0731,litellm/gemini-3.1-flash-lite,litellm/gpt-oss-120b
MODEL_TREND_ANALYSIS=litellm/deepseek-v4-flash-0731,litellm/gemini-3.1-flash-lite,litellm/gpt-oss-120b
MODEL_LIKE_RETWEET=litellm/deepseek-v4-flash-0731,litellm/gemini-3.1-flash-lite,litellm/gpt-oss-120b
MODEL_FOLLOW=litellm/deepseek-v4-flash-0731,litellm/gemini-3.1-flash-lite,litellm/gpt-oss-120b
MODEL_REFLECTION=litellm/deepseek-v4-flash-0731,litellm/gemini-3.1-flash-lite,litellm/gpt-oss-120b

# Security & Encryption (Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY=supersecretfernetkeyforlocaldev12=

# Network Ports
API_PORT=8200
DASHBOARD_PORT=3002

# ChatGPT Stealth Bridge & Image Engine
CHATGPT_BRIDGE_ENABLED=true
CHATGPT_BRIDGE_HEADLESS=true
IMAGE_GENERATION_PROVIDER=chatgpt,nvidia

# Optional Direct Provider Keys (if not routing through LiteLLM)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=

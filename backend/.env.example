# ── System ────────────────────────────────────────
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Path where all service config/data folders live on the host
# volumes will be created at ${CONFIG_PATH}/mcqsolver/{logs,model,dataset}
CONFIG_PATH=/opt/ajax

# ── MCQ Solver ────────────────────────────────────
# Docker image tag (default: latest)
MCQ_IMAGE_TAG=latest

# AI fallback keys — leave blank while AI_FALLBACK_ENABLED = False in main.py
MCQ_GEMINI_API_KEYS=
MCQ_NVIDIA_API_KEY=
MCQ_NVIDIA_MODEL=google/gemma-4-31b-it

# ── System ────────────────────────────────────────
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Path where all service config/data folders live on the host
CONFIG_PATH=/opt/ajax

# ── MCQ Solver ────────────────────────────────────
MCQ_IMAGE_TAG=latest

# AI fallback — set true + fill keys to enable Gemini/NVIDIA
MCQ_AI_FALLBACK=false
MCQ_GEMINI_API_KEYS=
MCQ_NVIDIA_API_KEY=
MCQ_NVIDIA_MODEL=google/gemma-4-31b-it

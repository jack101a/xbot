# FastAPI backend with Playwright Chromium support for dual architectures (amd64 and arm64)
FROM mcr.microsoft.com/playwright/python:v1.42.0-jammy

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN pip install --no-cache-dir uv

COPY backend/pyproject.toml .
RUN uv venv /opt/venv && \
    VIRTUAL_ENV=/opt/venv uv pip install --no-cache -r pyproject.toml

ENV PATH="/opt/venv/bin:$PATH"

# Ensure Chromium browser binary matches the installed Playwright library
RUN playwright install chromium

COPY backend/ .

# Copy entrypoint script
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8200

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "xbot.main:app", "--host", "0.0.0.0", "--port", "8200"]
